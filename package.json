{
  "name": "@gravitydock/dataframes",
  "version": "1.0.0",
  "description": "Gravity Dock Dataframes package",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=iife --global-name=__GravityDock_Package && esbuild src/ui.ts --bundle --outfile=dist/ui.js --platform=browser --format=iife --external:react --external:react-dom",
    "build:gdpkg": "npm run build && node scripts/build-gdpkg.js",
    "dev": "npm run build -- --watch"
  },
  "devDependencies": {
    "@gravitydock/types": "file:../types",
    "adm-zip": "^0.5.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "arquero": "^5.4.1",
    "xlsx": "^0.18.5"
  }
}
